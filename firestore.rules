rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId
        && data.email is string && data.email.size() > 0
        && (!('displayName' in data) || data.displayName is string)
        && (!('photoUrl' in data) || data.photoUrl is string)
        && (!('subscriptionTier' in data) || data.subscriptionTier in ['FREE', 'PREMIUM'])
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidMealPlan(data, userId) {
      return data.id is string && data.id.size() > 0
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() > 0
        && (!('notes' in data) || data.notes is string)
        && data.isActive is bool
        && data.mealsJson is string
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidShoppingItem(data, userId) {
      return data.id is string && data.id.size() > 0
        && data.userId is string && data.userId == userId
        && data.foodName is string && data.foodName.size() > 0
        && data.category is string
        && data.quantity is number && data.quantity >= 0
        && data.unit is string
        && data.isPurchased is bool
        && data.isManualExtra is bool
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);

      match /meal_plans/{planId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMealPlan(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /shopping_items/{itemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidShoppingItem(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
